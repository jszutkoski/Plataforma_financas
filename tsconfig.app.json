{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@app/*": ["./src/*"],
      "@fin/*": ["./src/financas/*"],
      "@pat/*": ["./src/patrimonio/*"],
      "@fin-shared/*": ["./shared/financas/*"],
      "@pat-shared/*": ["./shared/patrimonio/*"]
    }
  },
  "include": ["src", "shared"]
}
