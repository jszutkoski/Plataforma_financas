{
  "name": "financas-desktop",
  "productName": "Finanças",
  "version": "1.4.0",
  "private": true,
  "description": "Finanças pessoais e patrimônio — aplicativo local",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c green,blue \"vite\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5199 electron .",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist-electron --external:electron --out-extension:.js=.cjs",
    "build:web": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build": "npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "cross-env FINANCAS_DB=:memory: PATRIMONIO_DB=:memory: node --import ./scripts/testes/aliases.mjs --test core/financas/db.test.ts core/financas/persistencia.test.ts core/financas/natureza.test.ts core/financas/estorno.test.ts core/financas/categorias.test.ts src/financas/lib/analytics.test.ts src/financas/lib/import.test.ts src/financas/lib/projecao.test.ts src/lib/busca.test.ts core/patrimonio/db.test.ts core/patrimonio/historico.test.ts core/patrimonio/conciliacao.test.ts shared/patrimonio/calc.test.ts shared/patrimonio/auditoria.test.ts electron/versao.test.ts",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.financas.desktop",
    "productName": "Finanças",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "recursos"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "recursos/icone.png",
      "synopsis": "Finanças pessoais e patrimônio, tudo local",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "recursos/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/jszutkoski-alt/Plataforma_financas",
  "repository": {
    "type": "git",
    "url": "https://github.com/jszutkoski-alt/Plataforma_financas.git"
  },
  "bugs": {
    "url": "https://github.com/jszutkoski-alt/Plataforma_financas/issues"
  },
  "author": {
    "name": "jszutkoski-alt",
    "email": "319280082+jszutkoski-alt@users.noreply.github.com"
  },
  "desktopName": "financas-desktop.desktop"
}
